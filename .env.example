# Model. The agents call the pinned model through the Anthropic API.
ANTHROPIC_API_KEY=

# Chain. base-sepolia for the deployment; anvil for a local dry run. A shell export wins over this file.
CHAIN=base-sepolia

# Deployer. Funded by a human from a faucet; it funds the role wallets and deploys the contract.
DEPLOYER_KEY=
DEPLOYER_ADDRESS=

# Role wallets. `npm run -s wallets -- gen` fills these in. Never commit them.
BUYER_KEY=
SELLER_KEY=
ROGUE_KEY=
NEWCOMER_KEY=
ARBITER_KEY=
ARBITER_ADDRESS=

# Contract. Printed by the deploy script as MARKET_ADDRESS=...
MARKET_ADDRESS=

# Polling. How often the watchers read the chain, in milliseconds.
POLL_MS=3000
